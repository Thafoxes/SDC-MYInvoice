# Copy to .env. Never put tokens in VITE_* variables.
# Enable server persistence and customer-document OCR independently of Telegram.
VITE_BACKEND_ENABLED=true
VITE_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BUSINESS_ID=biz-001
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# Exact beneficiary account name expected on test receipts. Empty => review all.
RECEIPT_BENEFICIARY=Kedai Maju Jaya Sdn Bhd
# Python 3.11/3.12 virtual environment with server/requirements.txt installed.
DOCLING_PYTHON=.venv-telegram/Scripts/python.exe
FRONTEND_ORIGIN=http://localhost:5173
