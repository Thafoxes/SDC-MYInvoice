# =============================================================================
# NudgeWise - example environment configuration
# =============================================================================
# Local dev : copy this file to `.env` and fill in the values.
# Replit    : add each key below to the Replit Secrets tab instead of a file.
#
# Never commit real values. `.env` is git-ignored; only this example is tracked.
#
# All variables here are SERVER-SIDE ONLY. Do NOT prefix secrets with `VITE_`:
# Vite bundles any `VITE_*` variable into browser code, where anyone can read it.
# =============================================================================


# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL of the backend (used to build the Telegram webhook URL).
# Local: http://localhost:3000   Replit: https://<your-app>.replit.app
APP_BASE_URL=http://localhost:3000
# Business dates for reminder checkpoints are calculated in this timezone.
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
# Signs seller/staff sessions. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# --- Database (persistent SQL) -----------------------------------------------
# Business records, approvals, checkpoints and activity history live here.
# Do not rely on the Replit app filesystem for persistence.
# Replit's built-in PostgreSQL sets DATABASE_URL automatically.
DATABASE_URL=postgresql://nudgewise:password@localhost:5432/nudgewise


# --- Telegram ----------------------------------------------------------------
# Bot token from @BotFather. Keep server-side only.
TELEGRAM_BOT_TOKEN=
# Bot username without the @ (used for customer opt-in / deep links).
TELEGRAM_BOT_USERNAME=
# Random string sent to Telegram via setWebhook `secret_token`; every incoming
# webhook must carry it in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
# Path appended to APP_BASE_URL when registering the webhook.
TELEGRAM_WEBHOOK_PATH=/api/telegram/webhook


# --- AI inference: Gemma 4 via Ollama ----------------------------------------
# Local dev : http://localhost:11434 (Ollama running on your machine)
# Hosted    : authenticated HTTPS endpoint in front of Ollama on a RunPod GPU Pod,
#             e.g. https://<pod-id>-<port>.proxy.runpod.net
# Note: a Replit deployment cannot reach Ollama on your laptop via localhost.
OLLAMA_BASE_URL=http://localhost:11434
# Pin an explicit, tested model tag/quantisation.
OLLAMA_MODEL=gemma4:e4b
# Bearer token checked by the auth proxy in front of the hosted Ollama.
# Leave empty for local Ollama; REQUIRED for the hosted endpoint.
OLLAMA_API_KEY=
# Requests slower than this fall back to the fixed reminder template.
INFERENCE_TIMEOUT_MS=30000
# Set to false to force template drafting (fallback indicator stays visible).
AI_ENABLED=true


# --- RunPod (pod management only) --------------------------------------------
# Only needed for scripts that start/stop the GPU Pod. The app itself talks to
# the pod through OLLAMA_BASE_URL + OLLAMA_API_KEY above.
RUNPOD_API_KEY=
RUNPOD_POD_ID=


# --- Simulated Orbyte connector & demo ---------------------------------------
# The Orbyte connector is simulated; do not point this at a live Orbyte API.
ORBYTE_CONNECTOR_MODE=simulated
# Enables the labelled demo clock, reset controls and synthetic payment events.
DEMO_MODE=true
# Local time (BUSINESS_TIMEZONE) to send the daily seller summary, HH:MM.
DAILY_SUMMARY_TIME=09:00
