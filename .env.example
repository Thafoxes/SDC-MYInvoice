# Copy to .env and restart the backend after changing server settings.
# Keep .env private. Never put passwords or API keys in VITE_* variables.

# --- Database ---
# mariadb requires a running MySQL/MariaDB server at DB_HOST:DB_PORT.
# phpMyAdmin is an admin UI, not the database server.
# Set DB_CLIENT=sqlite for local file storage; DB_* settings below are then unused.
DB_CLIENT=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nudgewise_db
DB_USER=nudgewise_app
DB_PASSWORD=

# --- Application ---
VITE_BACKEND_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
# Exact beneficiary account name expected on test receipts. Empty => review all.
RECEIPT_BENEFICIARY=Kedai Maju Jaya Sdn Bhd

# --- AI provider ---
# cloud: Ollama Cloud using the key below (no Runpod requests).
# ollama: only OLLAMA_BASE_URL, either your computer or a Runpod Pod.
# auto: try OLLAMA_BASE_URL first, then cloud if that request fails.
# off: disable AI requests.
AI_PROVIDER=cloud
AI_TIMEOUT_MS=120000

# Ollama Cloud (used by cloud, or as fallback in auto).
OLLAMA_API_KEY=
CLOUD_AI_BASE_URL=https://ollama.com
# Set to an exact model available on your cloud account.
# Empty uses OLLAMA_MODEL below.
CLOUD_AI_MODEL=
# Optional gateway/cloud token; when set, takes priority over OLLAMA_API_KEY.
# CLOUD_AI_API_KEY=

# Local or Runpod Ollama (used by ollama and auto; no API key is sent).
# Local: http://localhost:11434
# Runpod: https://YOUR_POD_ID-11434.proxy.runpod.net
# Protect a public Runpod API before sending private business data.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b

# --- Document OCR ---
# Python environment with server/requirements.txt installed.
# Linux/macOS: .venv/bin/python
# Windows: .venv/Scripts/python.exe
DOCLING_PYTHON=.venv/bin/python
