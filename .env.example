# NudgeWise environment variables
# Copy to `.env` for local dev, or add to Replit Secrets when hosted.
# Never commit real values.

# -----------------------------------------------------------------
# Frontend (Vue / Vite)
# VITE_* values are bundled into browser code: public config only, never secrets.
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_DEMO_MODE=true

# -----------------------------------------------------------------
# Backend (server-side only)
# -----------------------------------------------------------------
PORT=3000
APP_BASE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
SESSION_SECRET=
DATABASE_URL=postgresql://nudgewise:password@localhost:5432/nudgewise

# Telegram (bot token from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Gemma 4 via Ollama
# Local: http://localhost:11434 | Hosted: RunPod HTTPS endpoint (API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_API_KEY=
AI_ENABLED=true

# RunPod (only needed for pod start/stop scripts)
RUNPOD_API_KEY=
RUNPOD_POD_ID=
