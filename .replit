modules = ["web", "python-3.12", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["oneDNN", "re2"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
DOCLING_PYTHON = ".pythonlibs/bin/python"
PORT = "5000"

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start"]
build = ["sh", "-c", "npm ci && UV_PROJECT_ENVIRONMENT=.pythonlibs uv sync --frozen"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
