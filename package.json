{
  "name": "nudgewise-vue-demo",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "start": "npm run build && npm run server",
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test:logic": "tsc -p tsconfig.logic-tests.json && node tests/setup-test-build.cjs && node --test tests/logic.test.cjs tests/language.test.cjs tests/customer-orders.test.cjs",
    "server:build": "tsc -p tsconfig.server.json && node server/build.cjs",
    "server": "npm run server:build && node --env-file-if-exists=.env server/app.cjs",
    "test:telegram": "npm run server:build && node --test tests/telegram.test.cjs tests/ollama.test.cjs tests/rewrite.test.cjs",
    "test:ui": "node --test tests/presentation.test.cjs tests/tone.test.cjs tests/order-stages.test.cjs tests/blocker-request.test.cjs",
    "test:customers": "npm run server:build && node --test tests/customer-orders-server.test.cjs",
    "test:po": "npm run server:build && node --test tests/purchase-order.test.cjs",
    "test:telegram:live": "npm run server:build && node --env-file-if-exists=.env tests/telegram-live.cjs",
    "test:workflow": "npm run server:build && node --test tests/order-workflow.test.cjs tests/credit-note.test.cjs",
    "test:ai-v2": "node --test tests/ai-provider-v2.test.cjs",
    "test:mariadb": "npm run server:build && node --test tests/mariadb-adapter.test.cjs",
    "db:check": "node --env-file-if-exists=.env server/mariadb-check.cjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "lucide-vue-next": "^0.468.0",
    "chart.js": "^4.4.7",
    "vue-chartjs": "^5.3.2",
    "mysql2": "^3.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
